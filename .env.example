VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Firebase Console > Project settings > General > Your apps > Web app > SDK config.
# Copy apiKey, authDomain, projectId and appId from that same web app.
# These are public browser configuration. Never add service-account/private keys.
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=REPLACE_ME
# Public HTTPS endpoint for the trusted server; never put Admin credentials here.
VITE_FIREBASE_PROVISIONING_URL=https://your-provisioning-host.example/provision
