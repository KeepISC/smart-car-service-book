# SERVER ONLY. Copy to a private directory OUTSIDE this repository.
# Load with: node --env-file=C:/private/scsb/provisioning.env server/index.mjs
# Never copy these into VITE_ variables. Existing server/.env.local is optional.
FIREBASE_PROJECT_ID=your-project
# Prefer workload identity / application-default credentials in production.
# For local development, use a service-account file OUTSIDE this repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/private/scsb/firebase-admin.json
# Dedicated restricted PostgreSQL login, not postgres or a service-role API key.
# Set the real connection string in the server secret store. No sslmode/sslcert URL parameters.
# Direct: postgresql://scsb_provisioning_local:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Session pooler: use its dashboard hostname and username scsb_provisioning_local.PROJECT_REF.
PROVISIONING_DATABASE_URL=REPLACE_ME
PROVISIONING_DATABASE_CA_FILE=C:/private/scsb/supabase-root.crt
PROVISIONING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8787
