# Copy into a private directory. These placeholders contain no real credentials.
# This checks configuration only; it creates no resources and makes no API calls.
SCSB_ISOLATED_INTEGRATION=false
VITE_SERVICE_HISTORY_ENABLED=false
VITE_SUPABASE_URL=https://your-disposable-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=your-disposable-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-disposable-project
VITE_FIREBASE_APP_ID=REPLACE_ME
VITE_FIREBASE_PROVISIONING_URL=http://localhost:8797/provision
FIREBASE_PROJECT_ID=your-disposable-project
GOOGLE_APPLICATION_CREDENTIALS=C:/private/scsb/integration/firebase-admin.json
PROVISIONING_DATABASE_URL=REPLACE_WITH_PRIVATE_DISPOSABLE_CONNECTION
PROVISIONING_DATABASE_CA_FILE=C:/private/scsb/integration/supabase-root.crt
PROVISIONING_ALLOWED_ORIGINS=http://localhost:5173
PORT=8797
# The current provisioning server pins the production Supabase reference.
# Prepare a separately isolated backend/allowlist before starting real acceptance.
